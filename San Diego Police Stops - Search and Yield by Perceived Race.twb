            <datasource caption='ripa_mart_latest' name='federated.00zjlj6181693z15icjs81878exz' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p.Start Month' datatype='date' default-format='*MMM yyyy' name='[Parameter 3]' param-domain-type='list' role='measure' source-field='[federated.00zjlj6181693z15icjs81878exz].[stop_month]' type='quantitative' value='#2025-01-01#'>
              <calculation class='tableau' formula='#2025-01-01#' />
            </column>
            <column caption='p.End Month' datatype='date' default-format='*MMM yyyy' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2025-12-01#'>
              <calculation class='tableau' formula='#2025-12-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00zjlj6181693z15icjs81878exz'>
            <column caption='Stop Month' datatype='date' name='[stop_month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1g1lfu31tf8oj519f7crc0sxgyjr'>
            <column caption='_In Selected Date Range' datatype='boolean' name='[Calculation_2367204568134279191]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [stop_month]) &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 3])&#13;&#10;AND&#13;&#10;DATETRUNC(&apos;month&apos;, [stop_month]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 4])' />
            </column>
            <column caption='_Stopped Persons - Selected Period' datatype='integer' name='[Calculation_2367204568134393880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2367204568134279191]&#13;&#10;    THEN [total_stopped_persons]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='_Searched Persons - Selected Period' datatype='integer' name='[Calculation_2367204568134463513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2367204568134279191]&#13;&#10;    THEN [searched_persons]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='_Searched and Found Persons - Selected Period' datatype='integer' name='[Calculation_2367204568134516762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2367204568134279191]&#13;&#10;    THEN [searched_and_found_persons]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='_Search Rate - Selected Period' datatype='real' name='[Calculation_2367204568134561819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2367204568134463513]&#13;&#10;/&#13;&#10;[Calculation_2367204568134393880]' />
            </column>
            <column caption='_Yield Rate - Selected Period' datatype='real' name='[Calculation_2367204568134606876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2367204568134516762]&#13;&#10;/&#13;&#10;[Calculation_2367204568134463513]' />
            </column>
            <column caption='_Search Rate Row Ratio Color' datatype='real' name='[Calculation_2367204568199880734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF WINDOW_MIN([Calculation_2367204568134561819]) &lt;= 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    LN(&#13;&#10;        [Calculation_2367204568134561819]&#13;&#10;        /&#13;&#10;        WINDOW_MIN([Calculation_2367204568134561819])&#13;&#10;    )&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='_Tooltip Race Label' datatype='string' name='[Calculation_2367204570319999007]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [perceived_race]&#13;&#10;WHEN &quot;Black/African American&quot; THEN &quot;Black&quot;&#13;&#10;WHEN &quot;Hispanic/Latino(a)&quot; THEN &quot;Latino(a)&quot;&#13;&#10;ELSE [perceived_race]&#13;&#10;END' />
            </column>
