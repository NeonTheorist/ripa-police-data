    <worksheet name='Sheet 2 - Table - Search Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='17'>Search-rate differences by stop reason</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontsize='10'>Cell labels show search rate. Color intensity compares perceived race groups within each stop reason.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
