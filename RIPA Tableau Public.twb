    <worksheet name='Sheet 2 - Chart - Sparklines'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Full-history trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ripa_mart_latest' name='federated.00zjlj6181693z15icjs81878exz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Yield Rate' caption='p.Sparkline Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yield Rate&quot;'>
              <calculation class='tableau' formula='&quot;Yield Rate&quot;' />
              <aliases>
                <alias key='&quot;Search Rate&quot;' value='Search Rate' />
                <alias key='&quot;Yield Rate&quot;' value='Yield Rate' />
              </aliases>
            </column>
            <column caption='p.Start Month' datatype='date' default-format='*MMM yyyy' name='[Parameter 3]' param-domain-type='list' role='measure' source-field='[federated.00zjlj6181693z15icjs81878exz].[stop_month]' type='quantitative' value='#2025-01-01#'>
              <calculation class='tableau' formula='#2025-01-01#' />
            </column>
            <column caption='p.End Month' datatype='date' default-format='*MMM yyyy' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2025-12-01#'>
              <calculation class='tableau' formula='#2025-12-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00zjlj6181693z15icjs81878exz'>
            <column caption='_Selected Sparkline Metric' datatype='real' name='[Calculation_2367204567851966474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &quot;Search Rate&quot; THEN&#13;&#10;    IF ZN(SUM([total_stopped_persons])) = 0 THEN&#13;&#10;        0&#13;&#10;    ELSE&#13;&#10;        ZN(SUM([searched_persons])) / ZN(SUM([total_stopped_persons]))&#13;&#10;    END&#13;&#10;&#13;&#10;WHEN &quot;Yield Rate&quot; THEN&#13;&#10;    IF ZN(SUM([searched_persons])) = 0 THEN&#13;&#10;        0&#13;&#10;    ELSE&#13;&#10;        ZN(SUM([searched_and_found_persons])) / ZN(SUM([searched_persons]))&#13;&#10;    END&#13;&#10;&#13;&#10;WHEN &quot;Stopped Persons&quot; THEN&#13;&#10;    ZN(SUM([total_stopped_persons]))&#13;&#10;&#13;&#10;WHEN &quot;Searched Persons&quot; THEN&#13;&#10;    ZN(SUM([searched_persons]))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='_Sparkline Metric Label' datatype='string' name='[Calculation_2367204568118874126]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &quot;Search Rate&quot; THEN&#13;&#10;    STR(ROUND([Calculation_2367204567851966474] * 100, 1)) + &quot;%&quot;&#13;&#10;&#13;&#10;WHEN &quot;Yield Rate&quot; THEN&#13;&#10;    STR(ROUND([Calculation_2367204567851966474] * 100, 1)) + &quot;%&quot;&#13;&#10;&#13;&#10;WHEN &quot;Stopped Persons&quot; THEN&#13;&#10;    STR(INT(ROUND([Calculation_2367204567851966474], 0)))&#13;&#10;&#13;&#10;WHEN &quot;Searched Persons&quot; THEN&#13;&#10;    STR(INT(ROUND([Calculation_2367204567851966474], 0)))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='_Sparkline First and Last Label' datatype='string' name='[Calculation_2367204568120094735]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF FIRST() = 0 OR LAST() = 0 THEN&#13;&#10;    [Calculation_2367204568118874126]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='_Selected Sparkline Metric - Selected Range' datatype='real' name='[Calculation_2367204568124948502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(DATETRUNC(&apos;month&apos;, [stop_month])) &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 3])&#13;&#10;AND MIN(DATETRUNC(&apos;month&apos;, [stop_month])) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 4])&#13;&#10;THEN [Calculation_2367204567851966474]&#13;&#10;END' />
            </column>
            <column caption='_Tooltip Race Label' datatype='string' name='[Calculation_2367204570342166560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [perceived_race]&#13;&#10;WHEN &quot;Black/African American&quot; THEN &quot;Black&quot;&#13;&#10;WHEN &quot;Hispanic/Latino(a)&quot; THEN &quot;Latino(a)&quot;&#13;&#10;WHEN &quot;Middle Eastern or South Asian&quot; THEN &quot;M.E./S.Asian&quot;&#13;&#10;WHEN &quot;Multiple/ambiguous race&quot; THEN &quot;Multiple&quot;&#13;&#10;ELSE [perceived_race]&#13;&#10;END' />
            </column>
            <column-instance column='[stop_month]' derivation='Max' name='[max:stop_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2367204570342166560]' derivation='None' name='[none:Calculation_2367204570342166560:nk]' pivot='key' type='nominal' />
            <column-instance column='[perceived_race]' derivation='None' name='[none:perceived_race:nk]' pivot='key' type='nominal' />
            <column caption='Perceived Race' datatype='string' name='[perceived_race]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Black/African American&quot;' value='Black / African American' />
                <alias key='&quot;Hispanic/Latino(a)&quot;' value='Hispanic / Latino(a)' />
                <alias key='&quot;Middle Eastern or South Asian&quot;' value='Middle Eastern / S. Asian' />
                <alias key='&quot;Multiple/ambiguous race&quot;' value='Multiple / Ambiguous' />
              </aliases>
            </column>
            <column caption='Searched And Found Persons' datatype='integer' name='[searched_and_found_persons]' role='measure' type='quantitative' />
            <column caption='Searched Persons' datatype='integer' name='[searched_persons]' role='measure' type='quantitative' />
            <column caption='Stop Month' datatype='date' name='[stop_month]' role='dimension' type='ordinal' />
            <column-instance column='[stop_month]' derivation='Month-Trunc' name='[tmn:stop_month:qk]' pivot='key' type='quantitative' />
            <column caption='Total Stopped Persons' datatype='integer' name='[total_stopped_persons]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2367204567851966474]' derivation='User' name='[usr:Calculation_2367204567851966474:qk]' pivot='key' type='quantitative' />
