            <column-instance column='[Calculation_2367204568120094735]' derivation='User' name='[usr:Calculation_2367204568120094735:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[Calculation_2367204568124948502]' derivation='User' name='[usr:Calculation_2367204568124948502:qk]' pivot='key' type='quantitative' />
