      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.00zjlj6181693z15icjs81878exz].[usr:Calculation_2367204568122777617:qk]&quot;' value='Persons Stopped' />
          <alias key='&quot;[federated.00zjlj6181693z15icjs81878exz].[usr:Calculation_2367204568122859538:qk]&quot;' value='Persons Searched' />
          <alias key='&quot;[federated.00zjlj6181693z15icjs81878exz].[usr:Calculation_2367204568122945555:qk]&quot;' value='Search Rate' />
          <alias key='&quot;[federated.00zjlj6181693z15icjs81878exz].[usr:Calculation_2367204568123093012:qk]&quot;' value='Yield Rate' />
          <alias key='&quot;[federated.00zjlj6181693z15icjs81878exz].[usr:Calculation_2367204568123514901:qk]&quot;' value='Found Evidence' />
        </aliases>
      </column>
      <column caption='_Search Rate' datatype='real' name='[Calculation_2367204567508123648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([searched_persons]) / SUM([total_stopped_persons])' />
      </column>
      <column caption='_Yield Rate' datatype='real' name='[Calculation_2367204567508234241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([searched_and_found_persons]) / SUM([searched_persons])' />
      </column>
      <column caption='_Sheet 1 Race Group' datatype='boolean' name='[Calculation_2367204567508697090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[perceived_race] IN (&#13;&#10;    &quot;Asian&quot;,&#13;&#10;    &quot;Black/African American&quot;,&#13;&#10;    &quot;Hispanic/Latino(a)&quot;,&#13;&#10;    &quot;White&quot;&#13;&#10;)' />
      </column>
      <column caption='_Race Highlight' datatype='string' name='[Calculation_2367204567509155843]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [perceived_race] = [Parameters].[Parameter 1]&#13;&#10;THEN [perceived_race]&#13;&#10;ELSE &quot;Other comparison groups&quot;&#13;&#10;END' />
      </column>
      <column caption='_Selected Stopped Persons' datatype='integer' name='[Calculation_2367204567510630404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [perceived_race] = [Parameters].[Parameter 1]&#13;&#10;THEN [total_stopped_persons]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='_Selected Yield Rate' datatype='real' name='[Calculation_2367204567519985672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[_Selected Stopped Persons (copy 2)_2367204567518973958] / [_Selected Stopped Persons (copy)_2367204567518965765]' />
      </column>
      <column caption='_Selected Share of Stopped Persons' datatype='real' name='[Calculation_2367204567520096265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2367204567510630404] / SUM([total_stopped_persons])' />
      </column>
      <column caption='_Selected Sparkline Metric' datatype='real' name='[Calculation_2367204567851966474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &quot;Search Rate&quot; THEN&#13;&#10;    IF ZN(SUM([total_stopped_persons])) = 0 THEN&#13;&#10;        0&#13;&#10;    ELSE&#13;&#10;        ZN(SUM([searched_persons])) / ZN(SUM([total_stopped_persons]))&#13;&#10;    END&#13;&#10;&#13;&#10;WHEN &quot;Yield Rate&quot; THEN&#13;&#10;    IF ZN(SUM([searched_persons])) = 0 THEN&#13;&#10;        0&#13;&#10;    ELSE&#13;&#10;        ZN(SUM([searched_and_found_persons])) / ZN(SUM([searched_persons]))&#13;&#10;    END&#13;&#10;&#13;&#10;WHEN &quot;Stopped Persons&quot; THEN&#13;&#10;    ZN(SUM([total_stopped_persons]))&#13;&#10;&#13;&#10;WHEN &quot;Searched Persons&quot; THEN&#13;&#10;    ZN(SUM([searched_persons]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='_Stopped Persons' datatype='integer' name='[Calculation_2367204567854047243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_stopped_persons])' />
      </column>
      <column caption='_Searched Persons' datatype='integer' name='[Calculation_2367204567854100492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([searched_persons])' />
      </column>
      <column caption='_Searched and Found Persons' datatype='integer' name='[Calculation_2367204567854170125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([searched_and_found_persons])' />
      </column>
      <column caption='_Sparkline Metric Label' datatype='string' name='[Calculation_2367204568118874126]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &quot;Search Rate&quot; THEN&#13;&#10;    STR(ROUND([Calculation_2367204567851966474] * 100, 1)) + &quot;%&quot;&#13;&#10;&#13;&#10;WHEN &quot;Yield Rate&quot; THEN&#13;&#10;    STR(ROUND([Calculation_2367204567851966474] * 100, 1)) + &quot;%&quot;&#13;&#10;&#13;&#10;WHEN &quot;Stopped Persons&quot; THEN&#13;&#10;    STR(INT(ROUND([Calculation_2367204567851966474], 0)))&#13;&#10;&#13;&#10;WHEN &quot;Searched Persons&quot; THEN&#13;&#10;    STR(INT(ROUND([Calculation_2367204567851966474], 0)))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='_Sparkline First and Last Label' datatype='string' name='[Calculation_2367204568120094735]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF FIRST() = 0 OR LAST() = 0 THEN&#13;&#10;    [Calculation_2367204568118874126]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_In Selected Date Range' datatype='boolean' name='[Calculation_2367204568122421264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [stop_month]) &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 3])&#13;&#10;AND&#13;&#10;DATETRUNC(&apos;month&apos;, [stop_month]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 4])' />
      </column>
      <column caption='_Stopped Persons - Selected Period' datatype='integer' name='[Calculation_2367204568122777617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2367204568122421264]&#13;&#10;    THEN [total_stopped_persons]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='_Searched Persons - Selected Period' datatype='integer' name='[Calculation_2367204568122859538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2367204568122421264]&#13;&#10;    THEN [searched_persons]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='_Search Rate - Selected Period' datatype='real' name='[Calculation_2367204568122945555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2367204568122421264]&#13;&#10;    THEN [searched_persons]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Calculation_2367204568122421264]&#13;&#10;    THEN [total_stopped_persons]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='_Yield Rate - Selected Period' datatype='real' name='[Calculation_2367204568123093012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2367204568122421264]&#13;&#10;    THEN [searched_and_found_persons]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Calculation_2367204568122421264]&#13;&#10;    THEN [searched_persons]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='_Searched and Found Persons - Selected Period' datatype='integer' name='[Calculation_2367204568123514901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2367204568122421264]&#13;&#10;    THEN [searched_and_found_persons]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='_Selected Sparkline Metric - Selected Range' datatype='real' name='[Calculation_2367204568124948502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN(DATETRUNC(&apos;month&apos;, [stop_month])) &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 3])&#13;&#10;AND MIN(DATETRUNC(&apos;month&apos;, [stop_month])) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 4])&#13;&#10;THEN [Calculation_2367204567851966474]&#13;&#10;END' />
      </column>
      <column caption='_Tooltip Race Label' datatype='string' name='[Calculation_2367204570342166560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [perceived_race]&#13;&#10;WHEN &quot;Black/African American&quot; THEN &quot;Black&quot;&#13;&#10;WHEN &quot;Hispanic/Latino(a)&quot; THEN &quot;Latino(a)&quot;&#13;&#10;WHEN &quot;Middle Eastern or South Asian&quot; THEN &quot;M.E./S.Asian&quot;&#13;&#10;WHEN &quot;Multiple/ambiguous race&quot; THEN &quot;Multiple&quot;&#13;&#10;ELSE [perceived_race]&#13;&#10;END' />
      </column>
      <column caption='_Tooltip Month Label' datatype='string' name='[Calculation_2367204570351337505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;, [stop_month]), 3)&#13;&#10;+ &quot; &quot;&#13;&#10;+ STR(YEAR([stop_month]))' />
      </column>
      <column caption='_City Population Share' datatype='real' name='[Calculation_2367204570598584354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Asian&quot; THEN 0.172&#13;&#10;WHEN &quot;Black/African American&quot; THEN 0.054&#13;&#10;WHEN &quot;Hispanic/Latino(a)&quot; THEN 0.296&#13;&#10;WHEN &quot;White&quot; THEN 0.414&#13;&#10;END' />
      </column>
