            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' friendly-name='Text - Race profiles heading' h='5818' id='38' type-v2='text' w='98858' x='571' y='13091'>
            <formatted-text>
              <run fontalignment='1' fontcolor='#2f2f2f' fontsize='20'>Race profiles</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontsize='10'>KPIs reflect the selected period; sparklines show full history with the selected period highlighted.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' friendly-name='Text - Heatmap footer' h='3727' id='43' type-v2='text' w='98858' x='571' y='69909'>
            <formatted-text>
              <run fontcolor='#777777'>Color is normalized within each stop reason; darker cells indicate higher search rates relative to the other race groups in that row. Lower-volume stop reasons may have more volatile rates.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' friendly-name='Text - Traffic heading' h='6546' id='46' type-v2='text' w='98858' x='571' y='73636'>
            <formatted-text>
              <run fontcolor='#2f2f2f' fontsize='17'>Traffic violation stops</run>
              <run>
Traffic violation stops are expanded because they show a large search-rate gap in a common stop category.</run>
