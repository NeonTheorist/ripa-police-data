          <zone forceUpdate='true' friendly-name='Text - Heading' h='8273' id='33' type-v2='text' w='98858' x='571' y='727'>
            <formatted-text>
              <run fontalignment='1' fontcolor='#2f2f2f' fontsize='24'>Search and Yield Patterns by Perceived Race</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontsize='12'>Selected-period KPIs are shown alongside full-history trends; stop-reason views show where search-rate differences are concentrated.</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#777777'>Records are person-stops, not unique people. Race is officer-perceived. Smaller groups may have volatile rates.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f7f7f5' />
            </zone-style>
          </zone>
          <zone fixed-size='511' h='25909' id='5' is-fixed='true' name='Sheet 2 - Table - KPI' show-title='false' w='53643' x='571' y='18909'>
